# Preserve exact legacy/archive/reference bytes on every checkout.
# Literal padding and control characters are evidence, not formatting errors.
legacy/** -text -whitespace
# Source-derived tables are committed runtime inputs, regenerated by npm run audit.
src/generated/** linguist-generated=true
# PDP-10 binary exports and raw tape images are archival data, not host executables.
legacy/utexas-reference/**/*.EXE binary
legacy/utexas-reference/**/*.SYM binary
legacy/utexas-reference/**/*.tap binary
