--- upstream/simh/boot-from-disk.ini
+++ isolated/simh/boot-from-disk.ini
@@ -1,3 +1,4 @@
+set log /tmp/decwar-austin-reference/console.log
 set env SIM_NAME=KL-10
 set env DSK=RPA
 set env TAP=TUA
@@ -10,10 +11,9 @@
 set mta disable
 set tua enable
 set tty lines=64
-at tty -U 2030
-set ni enable
-at ni tap:tap0
-set dn rsx20
+at tty -U 127.0.0.1:2030
+set ni disable
+; DN disabled in bundled simulator source
 at lp20 -n prt.log
 at %DSK%0 dsk/%DN%_dskb0.rp6
 at %DSK%1 dsk/%DN%_dskb1.rp6

--- upstream/simh/utexas.do
+++ isolated/simh/utexas.do
@@ -3,7 +3,7 @@
 expect "Date:" send  "03-19-86\r"; continue
 expect "Time:" send  "0000\r"; continue
 expect "Startup option:" send  "quick\r"; continue
-expect "%TTY STOMPER - Starting" send "\3"; continue
+expect "?OPRALF LOOKUP failure 0" send "\3"; continue
 expect "\r\n*" continue
 expect "\r\n." continue
 expect "\r\n." continue
@@ -29,7 +29,7 @@
 expect "\r\n." send ""; continue
 ; line above is the expect hack, shouldn't be needed but seems to work
 expect "\r\n." send "r link\r"; continue
-expect "\r\n*" send "decwar/save\r"; continue
+expect "\r\n*" send "decwar/save/map/syfile\r"; continue
 expect "\r\n*" send "low/seg:low\r"; continue
 expect "\r\n*" send "high/seg:high\r"; continue
 expect "\r\n*" send "decwar/seg:def\r"; continue
